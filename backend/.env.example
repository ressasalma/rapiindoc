# ============================================================
# RapiInDoc Backend – Environment Variables (contoh)
# Salin ke .env dan sesuaikan nilainya
# ============================================================

# --- Aplikasi ---
APP_ENV=development
SECRET_KEY=GANTI_DENGAN_STRING_ACAK_PANJANG_MINIMAL_32_KARAKTER
DEBUG=true

# --- Database (MySQL) – hanya data sistem, bukan data pengguna ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rapiindoc
DB_USER=root
DB_PASSWORD=

# --- Redis – status job sementara, rate-limit, TTL sesi ---
REDIS_URL=redis://localhost:6379/0

# --- Penyimpanan sementara ---
TEMP_DIR=/tmp/rapiindoc
# Batas waktu retensi file (menit)
FILE_TTL_MINUTES=30
# Ukuran file maksimum (bytes, 20 MB)
MAX_FILE_SIZE=20971520

# --- Rate Limiting ---
RATE_LIMIT_UPLOAD=10          # unggahan per IP per menit
RATE_LIMIT_PROCESS=5          # job per IP per menit

# --- AI (opsional, hanya untuk blok ambigu) ---
AI_ENABLED=false
AI_PROVIDER=openai            # openai | anthropic | google
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_CHUNK_CHARS=500        # panjang maksimum potongan yang dikirim ke AI

# --- LibreOffice headless (konversi PDF) ---
LIBREOFFICE_PATH=soffice
